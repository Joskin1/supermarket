APP_NAME="White-Mart"
APP_ENV=local
APP_KEY=
# IMPORTANT: Set to false in production. true leaks stack traces, DB credentials, and env vars on errors.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Desktop Database (SQLite) ────────────────────────────────────────────
# SQLite is the primary database for the desktop app.
# The database file lives in database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE is left unset to use the default: database/database.sqlite

# ─── Legacy MySQL (only for data migration, not used at runtime) ──────────
# DB_MYSQL_HOST=127.0.0.1
# DB_MYSQL_PORT=3306
# DB_MYSQL_DATABASE=white-mart
# DB_MYSQL_USERNAME=root
# DB_MYSQL_PASSWORD=

# Bootstrap credentials for the initial sudo user.
# These are only used by SudoUserSeeder and must be set before seeding.
SUDO_EMAIL="whitemart@gmail.com"
SUDO_PASSWORD="whitemart@gmail.com"

# ─── Desktop Session ─────────────────────────────────────────────────────
# File-based sessions: no database dependency, persists across app restarts.
SESSION_DRIVER=file
# 1 year session lifetime — desktop users shouldn't re-login constantly.
SESSION_LIFETIME=525600
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Desktop Queue ───────────────────────────────────────────────────────
# Sync queue: jobs run inline. NativePHP manages its own queue worker.
QUEUE_CONNECTION=database

# ─── Desktop Cache ───────────────────────────────────────────────────────
# File-based cache: no Redis/Memcached needed for desktop.
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── NativePHP ────────────────────────────────────────────────────────────
NATIVEPHP_APP_ID=com.whitemart.desktop
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_AUTHOR="White-Mart"
NATIVEPHP_APP_COPYRIGHT="© 2026 White-Mart"
NATIVEPHP_APP_DESCRIPTION="White-Mart Supermarket Management System"

# ─── GitHub Auto-Updater ────────────────────────────────────────────────
NATIVEPHP_UPDATER_PROVIDER=github
GITHUB_REPO=
GITHUB_OWNER=
# GitHub Token is optional for public repos, required for private repos
GITHUB_TOKEN=

# ─── Online Crash Reporting ─────────────────────────────────────────────
# Sentry is recommended for capturing distributed desktop crashes.
# Once you create a Sentry account, run: composer require sentry/sentry-laravel
SENTRY_LARAVEL_DSN=
# Set trace sampling rate (e.g., 0.1 for 10% of transactions)
SENTRY_TRACES_SAMPLE_RATE=1.0
